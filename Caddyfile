# Bu server faqat API'ni beradi — ochiq sayt Cloudflare Workers'da
# (yonaltiruvchi.uz), u /api va /ws so'rovlarini shu "yashirin" origin
# hostiga proksilaydi. origin.yonaltiruvchi.uz DNS-only (kulrang bulut)
# yozuv sifatida shu server IP'siga ko'rsatilgan bo'lishi kerak — batafsil:
# CLOUDFLARE.md.
origin.yonaltiruvchi.uz {
	encode zstd gzip
	reverse_proxy web:8000
}
