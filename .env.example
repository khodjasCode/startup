# Nusxa oling: cp .env.example .env  (yoki export qiling)
# Kalitlarni hech qachon git'ga qo'shmang!
BOT_TOKEN=BotFather'dan_olingan_token
GEMINI_API_KEY=ai.google.dev'dan_olingan_kalit

# PostgreSQL (Supabase). Supabase → Project Settings → Database → Connection string
# → "Transaction pooler" (6543-port) manzilini oling va parolni qo'ying.
# ⚠️ Paroldagi maxsus belgilarni URL-kodlang: @ → %40, # → %23, / → %2F
DATABASE_URL=postgresql://postgres.PROJECT_REF:PAROL@aws-0-REGION.pooler.supabase.com:6543/postgres

# Katalog xotirada shuncha soniya keshlanadi (0 — keshsiz, har so'rovda bazadan).
COMPASS_KATALOG_KESH_SONIYA=300

# Telegram bot serverda webhook orqali ishlaydi (mahalliyda — polling).
# COMPASS_PUBLIC_URL — servisning ochiq manzili, TELEGRAM_WEBHOOK_SECRET —
# ixtiyoriy maxfiy satr: Telegram uni har so'rovda sarlavhada qaytaradi.
# Ro'yxatdan o'tkazish: python3 -m web.telegram_webhook --ornatish
COMPASS_PUBLIC_URL=https://sizning-servisingiz.onrender.com
TELEGRAM_WEBHOOK_SECRET=tasodifiy_uzun_satr
